import java.util.LinkedList;
import java.util.Queue;

class RecentCounter {

    Queue<Integer> queue;
    public RecentCounter() {
        queue = new LinkedList<>();
    }
    public int ping(int t) {
        queue.add(t);
        int minimumTimeAllowed = t - 3000;
        while (queue.peek() < minimumTimeAllowed) {
            queue.poll(); 
        }
        return queue.size();
    }
}
