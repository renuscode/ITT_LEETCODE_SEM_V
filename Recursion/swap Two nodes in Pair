class Solution {
    public ListNode swapPairs(ListNode head) {
        // Base case: If the list is empty or has only one node, no swaps needed
        if (head == null || head.next == null) {
            return head;
        }
        
        // Dummy node helps handle edge cases cleanly (like changing the head)
        ListNode dummy = new ListNode(0);
        dummy.next = head;
        ListNode point = dummy;
        
        // Ensure there are at least two nodes left to swap
        while (point.next != null && point.next.next != null) {
            ListNode swap1 = point.next;
            ListNode swap2 = point.next.next;
            
            // Changing pointers to swap the nodes
            swap1.next = swap2.next;
            swap2.next = swap1;
            point.next = swap2;
            
            // Move the pointer two steps forward to the next pair
            point = swap1;
        }
        
        return dummy.next;
    }
}
